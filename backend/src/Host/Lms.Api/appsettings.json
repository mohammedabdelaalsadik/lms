{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Identity": {
    "Mfa": { "RequiredForStaff": true },
    "Jwt": {
      "Issuer": "lms",
      "Audience": "lms-web",
      "LifetimeMinutes": 15,
      "RefreshLifetimeDays": 14
    }
  }
}
